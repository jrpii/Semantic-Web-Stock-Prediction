{"organizations": [], "uuid": "9f335df91b90383493822f069a0d9e6a751aa87b", "thread": {"social": {"gplus": {"shares": 0}, "pinterest": {"shares": 0}, "vk": {"shares": 0}, "linkedin": {"shares": 0}, "facebook": {"likes": 0, "shares": 0, "comments": 0}, "stumbledupon": {"shares": 0}}, "site_full": "news.morningstar.com", "main_image": "", "site_section": "http://news.morningstar.com/all/source/market-watch.aspx", "section_title": "News Archive: MarketWatch", "url": "http://news.morningstar.com/all/market-watch/TDJNMW20180925515/rare-apple-1-computer-sells-at-auction-for-375000.aspx", "country": "US", "domain_rank": 2618, "title": "Rare Apple 1 computer sells at auction for $375,000", "performance_score": 0, "site": "morningstar.com", "participants_count": 1, "title_full": "", "spam_score": 0.0, "site_type": "news", "published": "2018-09-25T03:00:00.000+03:00", "replies_count": 0, "uuid": "9f335df91b90383493822f069a0d9e6a751aa87b"}, "author": "morningstar.com", "url": "http://news.morningstar.com/all/market-watch/TDJNMW20180925515/rare-apple-1-computer-sells-at-auction-for-375000.aspx", "ord_in_thread": 0, "title": "Rare Apple 1 computer sells at auction for $375,000", "locations": [], "entities": {"persons": [{"name": "steve wozniak", "sentiment": "negative"}, {"name": "steve jobs", "sentiment": "negative"}, {"name": "wozniak", "sentiment": "none"}, {"name": "steve kerch", "sentiment": "none"}, {"name": "rob weisberg", "sentiment": "none"}], "locations": [{"name": "palo alto", "sentiment": "none"}, {"name": "calif.", "sentiment": "none"}], "organizations": [{"name": "apple", "sentiment": "negative"}, {"name": "apple computer", "sentiment": "none"}, {"name": "rr auction", "sentiment": "none"}]}, "highlightText": "", "language": "english", "persons": [], "text": "A rare Apple 1 computer, one of only 200 originally built by Steve Jobs and Steve Wozniak at fledgling Apple Computer [S:AAPL] in Palo Alto, Calif., in 1976, was sold at auction Tuesday for $375,000, auctioneer RR Auction and auction platform Invaluable said in a press release. The computer is 1 of only 16 of the originals known to still be fully functional, Invaluable CEO Rob Weisberg said. The companies did not identify the seller or the buyer but said the seller originally purchased the machine for $300 and had earlier tried to sell it to Wozniak for $10,000.\n-Steve Kerch;\n 2336ET\n ", "external_links": ["http://www.addthis.com/bookmark.php?v=250"], "published": "2018-09-25T03:00:00.000+03:00", "crawled": "2018-09-26T15:08:24.031+03:00", "highlightTitle": ""}